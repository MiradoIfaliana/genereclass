export class <<Pagename>>Component {
  popoActiveSave: boolean =false;
  popoActiveUpdate: boolean =false;
  popoActiveListe: boolean =false;
  <<entityname>>s:any;
  <<entityname>>:any;
  <<entityname>>create={<<fieldtemple>><<field>>:<<value>><</fieldtemple>>};
<<instance-sousentityname>>  <<sousentityname>>s:any;<</instance-sousentityname>>
  depart:number=1;
  nbaffiche:number=5;
  doprevnext:boolean =false;

  constructor(private http: HttpClient) {
    this.set<<Entityname>>s();
    }

//------------------------------------------------------------------------WEBSERVICE
  //READ---LISTE
  async set<<Entityname>>s() {
    try {
      const response: any = await this.http.get('#endpointreaddetailed#?depart=' + this.depart + '&nbaffiche=' + this.nbaffiche, {}).toPromise(); 
      if (response.data != null) {
        this.<<entityname>>s=response.data;
        this.doprevnext = true;
      } else {
        this.doprevnext = false;
      }
    } catch (error) {
      console.error('Une erreur s\'est produite : ', error);
      alert("error");
    }
  }

  async prev(){
    this.depart=this.depart-this.nbaffiche;
    await this.set<<Entityname>>s();
    if(this.doprevnext==false){ 
      this.depart=this.depart+this.nbaffiche; //retour a l'etat initial
      alert("il n'y a plus de precedent");       
    }
    this.doprevnext=false;
  
  }
  async next(){
    this.depart=this.depart+this.nbaffiche;
    await this.set<<Entityname>>s();
    if(this.doprevnext==false){ 
      this.depart=this.depart-this.nbaffiche; //retour a l'etat initial
      alert("il n'y a plus de suivant"); 
    }
    this.doprevnext=false;
  }

  //SOUS-LISTE
<<templ-read-sousentity>>  set<<Sousentityname>>(){
    this.http.get('#endpointread#', {}).subscribe((response :any) => {
      this.<<sousentityname>>s=response.data;
    },
      (error) => {
        alert("error");
        console.error('Une erreur s\'est produite : ', error);
      }
    );
  }<</templ-read-sousentity>>

  //recuperation by Id
  set<<Entityname>>ById(id:number){
    if(this.<<entityname>>s!=null){
      for(let i=0;i<this.<<entityname>>s.length;i++){
        if(this.<<entityname>>s[i].<<namepk>>==id){ this.<<entityname>>=this.<<entityname>>s[i]; }
      }
    }
  }
  //CREATE
  submitFormCreate() {
    console.log(this.<<entityname>>create);
    // Envoi de la requête POST                                   
    this.http.post('#endpointcreate#', this.<<entityname>>create).subscribe((response :any) => {
      //console.log(response);
      alert(response.message);
    },
      (error) => {
        alert("error");
        console.error('Une erreur s\'est produite : ', error);
      }
    );
  }

  //UPDATE
  submitFormUpdate(id: number) {
    console.log(this.<<entityname>>);
    // Envoi de la requête POST
    this.http.put('#endpointupdate#'+id, this.<<entityname>>).subscribe((response :any) => {
      //console.log(response);
      alert(response.message);
    },
      (error) => {
        alert("error");
        console.error('Une erreur s\'est produite : ', error);
      }
    );
  }
  //DELETE
  delete(id: number) {
    this.http.delete('#endpointdelete#'+id).subscribe((response:any) => {
      //console.log(response);
      alert(response.message);
    },
      (error) => {
        alert("error");
        console.error('Une erreur s\'est produite : ', error);
      }
    );
  }
//----------------------------------------------------------------------POPOP
  //afficher le form d'insert
  popopSave(){
    this.popoActiveUpdate = false;
    this.popoActiveListe = false;
    this.popoActiveSave = !this.popoActiveSave;
    if(this.popoActiveSave==true){
<<templ-method-setsousentity>>      this.set<<Sousentityname>>();<</templ-method-setsousentity>>
    }
  }

  //afficher le form d'update
  popopUpdate(id:number){
    this.popoActiveSave = false;
    this.popoActiveListe = false;
    this.popoActiveUpdate = !this.popoActiveUpdate;
    if(this.popoActiveUpdate==true){
      this.set<<Entityname>>ById(id);
      console.log(this.<<entityname>>);
<<templ-method-setsousentity02>>      this.set<<Sousentityname>>();<</templ-method-setsousentity02>>
    }
  }
  
  //afficher les listes
  popopListe(){
    this.popoActiveSave = false;
    this.popoActiveUpdate = false;
    this.popoActiveListe = !this.popoActiveListe;
    if(this.popoActiveListe==true){
      this.set<<Entityname>>s();
    }
  }
//-----------------------------------------------------------


}
